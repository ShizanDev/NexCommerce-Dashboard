generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH USER ============

model AuthUser {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String   @default("")
  role       String   @default("admin")
  emailVerified Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ OTP VERIFICATION ============

model OtpRecord {
  id        String   @id @default(cuid())
  email     String
  otp       String
  purpose   String   // "signup" | "login"
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============ WOOCOMMERCE ORDERS ============

model WooCommerceOrder {
  id              String    @id @default(cuid())
  wooOrderId      Int       @unique
  orderNumber     String
  status          String
  customerName    String
  customerEmail   String
  itemsJson       String    @default("[]")
  totalAmount     Float
  currency        String    @default("INR")
  paymentMethod   String    @default("")
  paymentStatus   String    @default("pending")
  billingAddress  String    @default("")
  shippingAddress String    @default("")
  customerNote    String    @default("")
  dateCreated     DateTime
  dateModified    DateTime?
  datePaid        DateTime?
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============ CUSTOMERS (synced from WC) ============

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String   @default("")
  address   String   @default("")
  city      String   @default("")
  state     String   @default("")
  zipCode   String   @default("")
  country   String   @default("")
  totalSpent Float   @default(0.0)
  orderCount Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ PRODUCTS (synced from WC) ============

model Product {
  id            String   @id @default(cuid())
  wooId        Int      @unique
  name         String
  sku          String   @default("")
  price        Float    @default(0)
  regularPrice Float    @default(0)
  salePrice    Float    @default(0)
  imageUrl     String   @default("")
  category     String   @default("")
  status       String   @default("publish")
  stockStatus  String   @default("instock")
  stockQty     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============ SYSTEM SETTINGS ============

model SystemSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}
