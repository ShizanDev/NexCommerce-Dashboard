generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH USER ============

model AuthUser {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String    @default("")
  role          String    @default("admin") // "admin" | "super_admin"
  status        String    @default("active") // "active" | "suspended" | "deactivated"
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============ OTP VERIFICATION ============

model OtpRecord {
  id        String   @id @default(cuid())
  email     String
  otp       String
  purpose   String   // "signup" | "login"
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ============ WOOCOMMERCE ORDERS ============

model WooCommerceOrder {
  id              String    @id @default(cuid())
  wooOrderId      Int       @unique
  userId          String    @default("")
  orderNumber     String
  status          String
  customerName    String
  customerEmail   String
  itemsJson       String    @default("[]")
  totalAmount     Float
  currency        String    @default("INR")
  paymentMethod   String    @default("")
  paymentStatus   String    @default("pending")
  billingAddress  String    @default("")
  shippingAddress String    @default("")
  customerNote    String    @default("")
  dateCreated     DateTime
  dateModified    DateTime?
  datePaid        DateTime?
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([dateCreated])
}

// ============ CUSTOMERS (synced from WC) ============

model Customer {
  id        String   @id @default(cuid())
  userId    String   @default("")
  name      String
  email     String
  phone     String   @default("")
  address   String   @default("")
  city      String   @default("")
  state     String   @default("")
  zipCode   String   @default("")
  country   String   @default("")
  totalSpent Float   @default(0.0)
  orderCount Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, userId])
  @@index([userId])
}

// ============ PRODUCTS (synced from WC) ============

model Product {
  id            String   @id @default(cuid())
  userId        String   @default("")
  wooId         Int      @unique
  name          String
  sku           String   @default("")
  price         Float    @default(0)
  regularPrice  Float    @default(0)
  salePrice     Float    @default(0)
  imageUrl      String   @default("")
  category      String   @default("")
  status        String   @default("publish")
  stockStatus   String   @default("instock")
  stockQty      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ============ SYSTEM SETTINGS (global / owner-only) ============

model SystemSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}

// ============ AUDIT LOG ============

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @default("")
  userName   String   @default("")
  userEmail  String   @default("")
  action     String   // "user.create" | "user.role_change" | "user.suspend" | "user.delete" | "user.login" | "settings.update" | "system.backup" | etc.
  target     String   @default("") // what was affected (user email, setting key, etc.)
  details    String   @default("") // JSON or text details
  ipAddress   String   @default("")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============ USER SETTINGS (per-user: WC, currency, notifications) ============

model UserSettings {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ============ PLATFORM ACTIVITY (real-time events) ============

model PlatformEvent {
  id        String   @id @default(cuid())
  type      String   // "signup" | "login" | "wc_connected" | "wc_synced" | "order_placed" | "settings_changed"
  title     String
  message   String   @default("")
  userId    String   @default("")
  metadata  String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([userId])
}
