generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH USER ============

model AuthUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("")
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ WOOCOMMERCE ORDERS ============

model WooCommerceOrder {
  id              String    @id @default(cuid())
  wooOrderId      Int       @unique
  orderNumber     String
  status          String
  customerName    String
  customerEmail   String
  itemsJson       String    @default("[]")
  totalAmount     Float
  currency        String    @default("INR")
  paymentMethod   String    @default("")
  paymentStatus   String    @default("pending")
  billingAddress  String    @default("")
  shippingAddress String    @default("")
  customerNote    String    @default("")
  dateCreated     DateTime
  dateModified    DateTime?
  datePaid        DateTime?
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============ CUSTOMERS (synced from WC) ============

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String   @default("")
  address   String   @default("")
  city      String   @default("")
  state     String   @default("")
  zipCode   String   @default("")
  country   String   @default("")
  totalSpent Float   @default(0.0)
  orderCount Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ PRODUCTS (synced from WC) ============

model Product {
  id          String   @id @default(cuid())
  wooId       Int      @unique
  name        String
  sku         String   @default("")
  price       Float
  imageUrl    String   @default("")
  description String   @default("")
  status      String   @default("publish")
  stockQty    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ SYSTEM SETTINGS ============

model SystemSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}
